/* ===== Paleta base (misma que la guía HTML) ===== */
QMainWindow, #centralwidget {
    background-color: #17181a;
    color: #eceded;
}
QWidget {
    font-family: &quot;Segoe UI&quot;;
    font-size: 12px;
    color: #eceded;
}

/* ===== Menú superior ===== */
QMenuBar {
    background-color: #131315;
    border-bottom: 1px solid #2a2b2e;
    padding: 2px 6px;
}
QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    color: #8f9095;
}
QMenuBar::item:selected {
    background-color: #26272a;
    color: #eceded;
    border-radius: 4px;
}
QMenu {
    background-color: #1d1e21;
    border: 1px solid #333438;
    color: #eceded;
}
QMenu::item:selected {
    background-color: rgba(47,123,246,0.18);
}

/* ===== Barra vertical de extensiones (pegada al marco izquierdo) ===== */
QToolBar#toolBarExtensions {
    background-color: #131415;
    border: none;
    border-right: 1px solid #2a2b2e;
    spacing: 6px;
    padding: 10px 6px;
}
QToolBar#toolBarExtensions QToolButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 7px;
    color: #626367;
}
QToolBar#toolBarExtensions QToolButton:hover {
    background-color: #26272a;
    color: #8f9095;
}
QToolBar#toolBarExtensions QToolButton:checked {
    background-color: rgba(47,123,246,0.16);
    color: #4a8dff;
}

/* ===== Toolbar de comandos Kratos (fila superior del área central) ===== */
QToolBar#toolBarKratos {
    background-color: #17181a;
    border: none;
    border-bottom: 1px solid #2a2b2e;
    spacing: 2px;
    padding: 6px 12px;
}
QToolBar#toolBarKratos QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 8px;
    color: #8f9095;
}
QToolBar#toolBarKratos QToolButton:hover {
    background-color: #26272a;
    color: #eceded;
}
QToolBar#toolBarKratos QToolButton:checked {
    background-color: rgba(47,123,246,0.18);
    border-color: rgba(74,141,255,0.5);
    color: #4a8dff;
}

/* ===== Tabs de workspace (Modelo / Optimización / Simulación / Fabricación) ===== */
QWidget#workspaceTabsWidget {
    background-color: #141416;
    border-bottom: 1px solid #2a2b2e;
}
QWidget#workspaceTabsWidget QToolButton {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 6px 12px;
    color: #8f9095;
}
QWidget#workspaceTabsWidget QToolButton:checked {
    color: #eceded;
    border-bottom: 2px solid #2f7bf6;
}
QLabel#labelDocName {
    color: #626367;
    font-size: 11px;
    padding-left: 12px;
}

/* ===== Panel de árbol (Part Studio) ===== */
QWidget#treePanel {
    background-color: #17181a;
    border-right: 1px solid #2a2b2e;
}
QLabel.panelHeader {
    color: #8f9095;
    font-size: 11px;
    font-weight: 600;
}
QTreeWidget {
    background-color: #17181a;
    border: none;
    color: #8f9095;
    font-size: 12px;
    show-decoration-selected: 1;
}
QTreeWidget::item {
    padding: 4px 2px;
    border-radius: 4px;
}
QTreeWidget::item:selected {
    background-color: rgba(47,123,246,0.18);
    color: #eceded;
}
QTreeWidget::item:hover {
    background-color: #26272a;
}
QListWidget#listWidgetParts {
    background-color: #17181a;
    border: none;
    color: #8f9095;
    font-size: 12px;
}
QListWidget#listWidgetParts::item {
    padding: 4px 2px;
    border-radius: 4px;
}
QListWidget#listWidgetParts::item:hover {
    background-color: #26272a;
}

/* ===== Viewport ===== */
QFrame#viewportWidget {
    background-color: #303134;
    border: none;
}
QLabel#labelViewportTitle {
    color: #eceded;
    font-size: 12px;
    font-weight: 600;
}
QLabel#labelViewportBadge {
    color: #bcd8ff;
    background-color: rgba(47,123,246,0.16);
    border: 1px solid rgba(74,141,255,0.38);
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 10px;
}
QLabel#labelPlaceholder {
    color: #626367;
    font-size: 11px;
}

/* ===== Franja inferior de datos (QStatusBar) ===== */
QStatusBar {
    background-color: #141416;
    border-top: 1px solid #2a2b2e;
    color: #8f9095;
    font-size: 11px;
}
QStatusBar QLabel {
    color: #8f9095;
    padding: 0px 10px;
}
QStatusBar::item {
    border: none;
}

/* ===== Splitter ===== */
QSplitter::handle {
    background-color: #2a2b2e;
    width: 1px;
}
