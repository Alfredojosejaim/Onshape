# OAuth 2.0 application registered in the Onshape Developer Portal.
ONSHAPE_OAUTH_CLIENT_ID=
ONSHAPE_OAUTH_CLIENT_SECRET=
ONSHAPE_OAUTH_REDIRECT_URI=https://localhost:8000/oauth/callback
ONSHAPE_OAUTH_SCOPES=OAuth2Read OAuth2Write

# Local service configuration
JOB_DB_PATH=jobs.sqlite3
CORS_ORIGINS=https://localhost:8000,https://localhost:8001
PORT=8000
COOKIE_SECURE=true
SSL_CERTFILE=certs/localhost.pem
SSL_KEYFILE=certs/localhost-key.pem

# Certificates are generated by INICIAR_APLICACION.bat with mkcert.
