# Backend-only Onshape API keys. Never expose these values to the browser.
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=

# Optional local defaults; active document context should come from Onshape.
DID=
WID=
EID=

# Local service configuration
JOB_DB_PATH=jobs.sqlite3
CORS_ORIGINS=http://localhost:8001
PORT=8000

# The Onshape App Extension needs an externally reachable HTTPS backend URL.
# Configure its server URL separately; do not put secrets in this file.
